\relax 
\@writefile{toc}{\contentsline {section}{\numberline {1}Fonts}{1}{}\protected@file@percent }
\newlabel{sec:a}{{1}{1}{}{section.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2}Hyphenation}{1}{}\protected@file@percent }
\newlabel{sec:b}{{2}{1}{}{section.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces A table}}{1}{}\protected@file@percent }
\newlabel{tab:x}{{1}{1}{}{table.1}{}}
\gdef \@abspage@last{1}
