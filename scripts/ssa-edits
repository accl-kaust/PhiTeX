#!/usr/bin/env python3
"""The SSA edit harness (DESIGN 4.3, item 8): each case's edits as rebuilds
of ONE `PARTEX_SSA=1` process, each stage against plain partex (the same
binary, no `PARTEX_*` variable) run on the same sources.

    scripts/sandbox scripts/ssa-edits [--case NAME]... [--bin PATH]
        [--work DIR] [--jobs N] [--fixpoint] [--check] [--env K=V]...
        [--timeout S] [--mem-gb N] [--brief]

(`cargo xtask ssa-edits` runs it on the release binary, and `cargo xtask
check` with `--brief`.)

The cases: every incremental case of `xtask/src/e2e.rs` built `By::Watch`
(read from `INCREMENTAL` there), `machine_edits` (`edits.tex`, pdflatex
format, e2e's six edits, a seventh whose glyphs the fonts have, so that
each font's union is as it was and the job's end does not run, then
letters no page had, and their removal: the end runs for each) and
`machine_edits_dvi` (`edits-dvi.tex`, latex format), both under
`-output-directory=out` after two plain runs of the original text, as
e2e's `machine_edits` seeds them; `label`: the same document given a
`\\label` nothing refers to, then rebuilt twice with no edit;
`aux_reopen` (`reopen.tex`, pdflatex format): an edit in the first
paragraph, whose step opens the `.aux` and whose page opens the PDF, its
revert, and a later edit; `streams` (`streams.tex`): a line written to
the file a stream opened first, changed and back, after the stream opened
a second; `fatal_end` (`fatal-end.tex`): a word edited and back in a job
that ends fatally in its last page's output routine, not seeded: the
.aux the first build wrote is read by its next trip (or, one trip a
build, by the next stage's), which runs earlier steps again; and
`inputs` (`inputs.tex`): a file only tested for (`\\openin` and
`\\ifeof`), edited, and a line appended after the last line of a file
`\\input` (the primitive), then taken away, then a word of it changed,
the file's MD5 sum printed.

Each case runs in WORK/<case>/:
- `o/`: the oracle, one run per stage, the stage's edit made before it
  (`--fixpoint`: each stage run again while a file it wrote, but its log,
  DVI and PDF, changed, at most 5 runs, e2e's `fixpoint`);
- `p/`: one SSA process whose `PARTEX_SSA_REBUILD` lines each snapshot
  what the build before wrote, then make the next edit;
- an edit is made as e2e's `edit_file` makes it: the text with its
  marker replaced, its modification time fixed (`\\pdffilemoddate` must
  agree: inputs at 1758800000, edit k at 1758800000 + 1000 k), renamed
  over the file; an empty marker is a rebuild with no edit;
- `snap/{o,p}/<stage>/`: every file of the run directory after each stage
  (the format aside), compared stage by stage: byte for byte, and `.log`
  and `.blg` files without their first line (banner, date) and with
  `xtask/src/mask.rs`'s statistics masked, as e2e compares them;
- `logs/`: each process's terminal output and stderr; `results.json` in
  WORK holds every number.

The formats are built once per binary, in WORK/formats. Exits 1 if a stage
of a case differs or its SSA process failed, 2 on a usage error.
"""

import argparse
import concurrent.futures
import gzip
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import threading
import time
from pathlib import Path

SCRIPT = Path(__file__).resolve()
REPO = SCRIPT.parent.parent
EPOCH = 1_758_800_000
# (the oracle's fixed time: a PDF file and LaTeX's \time record it)
FIXED_TIME = {"SOURCE_DATE_EPOCH": str(EPOCH), "FORCE_SOURCE_DATE": "1"}

# e2e's flags for LaTeX runs (`machine_edits`, `LATEX_INI`)
LATEX_FLAGS = [
    "-no-shell-escape",
    "-no-parse-first-line",
    "-output-comment=partex",
    "-interaction=nonstopmode",
]
PLAIN_INI = ["-ini", "-interaction=nonstopmode", r"\input plain \dump"]
# key: (partex's arguments before the job's, the format's -ini run, its name)
FORMATS = {
    "plain-tex": (["--compat=tex"], PLAIN_INI, "plain"),
    "plain-pdftex": (["--compat=pdftex"], PLAIN_INI, "plain"),
    "pdflatex": (
        ["--compat=tex", "-engine=pdftex"],
        [*LATEX_FLAGS, "-ini", "-etex", "-jobname=pdflatex", "*pdflatex.ini"],
        "pdflatex",
    ),
    "latex": (
        ["--compat=tex", "-engine=pdftex"],
        [*LATEX_FLAGS, "-ini", "-etex", "-jobname=latex", "*latex.ini"],
        "latex",
    ),
}

# e2e.rs's `run_machine_edits` edits (its `long` written out), and one more
MACHINE_EDITS = [
    ("Para5x2 ", "Para5x2 TYPED "),
    ("Para20x1 ", "Para20x1 " + "inserted " * 150),
    ("Para5x2 TYPED ", "Para5x2 TYPED MORE "),
    ("Para2x0 ", "Para2x0 early "),
    ("Para7x1 ", "Para7x1 \n\nA paragraph of its own.\n\n"),
    ("\\label{sec:12}\n", "\\label{sec:12}\n\n"),
    # digits the fonts have from other pages' folios: each font's union is
    # as it was, so the job's end does not run (DESIGN 4.3, "The job's end")
    ("Para2x0 early ", "Para2x0 early 99 "),
    # letters no page had: a union grows and the end runs; then they go
    # and it shrinks again
    ("Para2x0 early 99 ", "Para2x0 early 99 QJZ "),
    ("Para2x0 early 99 QJZ ", "Para2x0 early 99 "),
    # the first paragraph, in the step that opens the .aux (\openout at
    # \begin{document}): the stream opened again is the same file
    ("Para0x0 ", "Para0x0 first "),
]
# e2e.rs's `run_machine_edits_dvi`
MACHINE_EDITS_DVI = [("P5x2 ", "P5x2 typed "), ("P2x0 ", "P2x0 early ")]
# the first paragraph of reopen.tex shares its step with \begin{document}'s
# \openout of the .aux; every page's shipout writes .aux lines (a \label
# per section): the stream opened again on the same file wakes none of them
REOPEN_EDITS = [
    ("Opening words", "Opening phrases"),
    ("Opening phrases", "Opening words"),
    ("Para5x2 ", "Para5x2 later "),
]
# streams.tex: a line its first file's step writes, changed and back,
# after the stream opened a second file
STREAMS_EDITS = [("{Beta}", "{Gamma}"), ("{Gamma}", "{Beta}")]
# images.tex: a caption, an image's size, the file one includes (its
# document then one image fewer, the other's one more), and back
IMAGES_EDITS = [
    ("edits.tex", "First caption.", "First caption, edited."),
    ("edits.tex", "width=0.5", "width=0.6"),
    ("edits.tex", "height=2cm]{images-hand}", "height=2cm]{images-fig}"),
    ("edits.tex", "height=2cm]{images-fig}", "height=2cm]{images-hand}"),
]
# preamble.tex (the Overleaf extension's): a package added to the
# preamble, which makes every step after it new (the cascade goes cold:
# the old steps after it retired at once), taken away, then a word
PREAMBLE_EDITS = [
    ("\\usepackage{tikz}\n", "\\usepackage{tikz}\n\\usepackage{circuitikz}\n"),
    ("\\usepackage{tikz}\n\\usepackage{circuitikz}\n", "\\usepackage{tikz}\n"),
    ("Cool init?", "Cool init!"),
]
# inputs.tex: the file only tested for, edited; a line appended to the
# file \input and taken away; a word of it, whose sum is printed
INPUTS_EDITS = [
