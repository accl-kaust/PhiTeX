    ("inputs-sub.tex", "its last line.\n", "its last line.\nAppended after it.\n"),
    ("inputs-sub.tex", "Appended after it.\n", ""),
    ("inputs-sub.tex", "Sub text", "Sub words"),
]
# fatal-end.tex: a word, edited and back, in a job that ends fatally in
# its last page's output routine
FATAL_EDITS = [("Hello world.", "Hello there."), ("Hello there.", "Hello world.")]
# names.tex (not seeded): an `\ifcsname` of a name the `.aux` defines at
# `\begin{document}` from the second trip on, which the first trip entered
# later in the document, as `\end{document}`'s `\@testdef` enters a
# `\bibcite`'s name (`SsaTracker::name_defined`); then a word and back
NAMES_EDITS = [
    ("Second paragraph.", "Second paragraph, edited."),
    ("Second paragraph, edited.", "Second paragraph."),
]
# a \label nothing refers to, then two rebuilds with no edit (LOG
# 2026-09-29, "A label no one refers to")
LABEL_EDITS = [("Para5x2 ", "Para5x2 \\label{new}"), ("", ""), ("", "")]
# edits.tex with `-synctex=1` (DESIGN 4.5): a word; a line split and
# joined again (the typeset text the same, its places not); a comment line
# (nothing typeset changes, the places after it move); a paragraph; a
