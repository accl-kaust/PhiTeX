#!/bin/bash
# The fast gate: one commit's checks as parallel accl jobs, one table.
#
#   scripts/accl/gate-fast [COMMIT]     submit the shards (default: HEAD);
#                                       prints the job ids
#   scripts/accl/gate-fast wait ID...   wait for them, fetch, print the table
#
#   scripts/accl/gate-fast edits [COMMIT]   amsldoc's edit histories at
#                                       -j 8 and 16 with 50 edits (the
#                                       measurement; the gate runs 10)
#   scripts/accl/gate-fast control CTL  build control commit CTL, time its
#                                       cold watch builds, record them in
#                                       scripts/accl/gate-control/CTL (commit
#                                       that): the ams shard reads them
#
# Shards (scripts/accl/gate-shard.sh, passed as text to job.sbatch's cmd
# task, so any commit can be gated): build (once per commit: phitex-tex's
# test binaries and the release CLI, published under
# phitex-runs/gate-bin/COMMIT on accl; a commit built before is not built
# again); lint (clippy -D warnings; fmt is local only, the image's rustfmt
# is another version; it builds its own, no wait); and, after the build
# (Slurm dependency, cancelled if it fails), on its binaries: suites
# (phitex-tex's pdftex edits pages plain etex hints inputs defuse_gaps);
# latex 0..N-1 (the latex target's non-ignored tests dealt out,
# GATE_LATEX_SHARDS, default 3); ams (amsldoc --exact-pdf at -j 1, 8, 16,
# md5 against the epoch oracle on acclhead1, the round counters with
# PHITEX_TEX_TIME=1; then the cold watch build at -j 1/8/16 timed by op
# class beside the control GATE_CONTROL's recorded timings, default
# 566fb842: gate-time.py); amsedit 8, amsedit 16 (the edit histories,
# GATE_AMS_EDITS edits, 10); para (bench/para4000.tex, plain pdfTeX, md5
# against GATE_PARA_MD5, wall, us per paragraph and realised critical path
# at -j 1/8/16, its edit histories); cg (para4000 at one thread under
# callgrind: startup Ir, node bodies' Ir per command, top 15).
# Every test runs in its own process, killed after GATE_TEST_TIMEOUT s
# (120): a hang is a red line, not a shard's timeout.
# GATE_LATEX_ORDER (test names, heaviest first) balances the latex shards.
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
H=acclhead1
slurm='export PATH=/opt/slurm/current/bin:$PATH;'
# (acclhead1 resets connections under load: one shared connection,
# retried, for these scripts and the accl, rsync and git they run)
export PATH="$here/sshmux":$PATH
runs=$HOME/code/flinner/phitex-runs
ORACLE=code/flinner/phitex-runs/amsldoc-oracle-epoch.pdf
# the latex tests heaviest first (measured: test-walls.txt of the shards)
ORDER_FILE=$here/gate-latex-order.txt
# (the workspace's path inside the container, the same in every job: the
# test binaries have their crates' paths compiled in)
ROOT=/gw

# the binaries of a commit on accl (gate-shard.sh build)
store() { echo "code/flinner/phitex-runs/gate-bin/$1"; }

# sub OPTS SHARD ARGS...: one shard of commit $c submitted, its job id
sub() {
  local opts=$1
  shift
  ACCL_COMMIT=$c ACCL_OPTS="$opts" "$here/accl" submit cmd \
    env GATE_LATEX_ORDER="$order" GATE_TIME_PY="$(cat "$here/gate-time.py")" \
    GATE_TEST_TIMEOUT="${GATE_TEST_TIMEOUT:-120}" GATE_TEST_PAR="${GATE_TEST_PAR:-5}" GATE_AMS_EDITS="${GATE_AMS_EDITS:-10}" \
    bash -c "$script" gate-shard "$@" 2>/dev/null
}

# the build job for $c unless its binaries are there: sets $dep, the
# sbatch options of a shard that runs on them (and appends the job to ids)
build_first() {
  local st b
  st=$(store "$c")
  dep=""
  if ssh $H "test -x $st/cli/phitex && test -x $st/tests/latex" 2>/dev/null; then
    echo "gate-fast: binaries of $c already built ($st)" >&2
  else
    b=$(sub "-c 16 --mem=64G -t 00:40:00 -J gf-build --export=ALL,ACCL_ROOT=$ROOT,ACCL_STORE_OUT=$st" build)
    ids+=("$b")
    dep="--dependency=afterok:$b --kill-on-invalid-dep=yes"
  fi
}

# the sbatch options of a shard on the binaries ($1: the store parts it copies in)
on_bins() {
  local st parts="" x
  st=$(store "$c")
  for x in $1; do parts="$parts${parts:+:}$st/$x"; done
  echo "$dep --export=ALL,ACCL_ROOT=$ROOT,ACCL_NO_CARGO=1,ACCL_STORE_IN=$parts"
}

submit() {
  local n k want
  c=$(git rev-parse "${1:-HEAD}^{commit}")
  want=$(ssh $H "md5sum $ORACLE" 2>/dev/null | cut -c1-32)
  [ -n "$want" ] || { echo "gate-fast: no oracle $ORACLE on $H" >&2; exit 1; }
  script=$(cat "$here/gate-shard.sh")
  n=${GATE_LATEX_SHARDS:-3}
  order=${GATE_LATEX_ORDER:-$( [ -f "$ORDER_FILE" ] && tr '\n' ' ' < "$ORDER_FILE" || true)}
  # (GATE_ONLY="lint ams": those shards only)
  on() { [ -z "${GATE_ONLY:-}" ] || [[ " $GATE_ONLY " == *" $1 "* ]]; }
  ids=()
  if on lint; then ids+=("$(sub "-c 10 --mem=32G -t 00:20:00 -J gf-lint" lint)"); fi
  build_first
  local T="tests/latex tests/build_s" S=tests C=cli
  if on suites; then ids+=("$(sub "-c 12 --mem=48G -t 00:20:00 -J gf-suites $(on_bins "$S")" suites)"); fi
  if on latex; then
    for ((k = 0; k < n; k++)); do
      ids+=("$(sub "-c 10 --mem=48G -t 00:20:00 -J gf-latex$k $(on_bins "$T")" latex "$k" "$n")")
    done
  fi
  # (the timing control: its timings as `gate-fast control` recorded
  # them, never built per gate; GATE_CONTROL= none)
  if on ams; then
    ids+=("$(sub "-c 18 --mem=48G -t 00:30:00 -J gf-ams $(on_bins "$C")" ams "$want" "${GATE_CONTROL-566fb842}")")
    ids+=("$(sub "-c 10 --mem=32G -t 00:30:00 -J gf-amsedit8 $(on_bins "$C")" amsedit 8)")
    ids+=("$(sub "-c 18 --mem=48G -t 00:30:00 -J gf-amsedit16 $(on_bins "$C")" amsedit 16)")
  fi
  # (para4000: plain pdfTeX, bytes against its bar, wall and the
  # realised critical path at -j 1/8/16)
  if on para; then ids+=("$(sub "-c 18 --mem=48G -t 00:30:00 -J gf-para $(on_bins "$C")" para "${GATE_PARA_MD5:-4146793290dc0ea887d79a1d2d1b4c89}")"); fi
  # (para4000 at one thread under callgrind: startup, node bodies' Ir
  # per command, the top 15)
  if on cg; then ids+=("$(sub "-c 8 --mem=24G -t 00:40:00 -J gf-cg $(on_bins "$C")" cg)"); fi
  echo "gate-fast: commit $c, oracle md5 $want" >&2
  mkdir -p "$runs"
  echo "$c ${ids[*]}" >> "$runs/gate-fast.ids"
  echo "${ids[*]}"
}

# the 50-edit histories (a measurement, not the gate)
edits50() {
  c=$(git rev-parse "${1:-HEAD}^{commit}")
  script=$(cat "$here/gate-shard.sh")
  order=""
  ids=()
  build_first
  local C=cli
  ids+=("$(GATE_AMS_EDITS=50 sub "-c 10 --mem=32G -t 01:00:00 -J gf-edits8 $(on_bins "$C")" amsedit 8)")
  ids+=("$(GATE_AMS_EDITS=50 sub "-c 18 --mem=48G -t 01:00:00 -J gf-edits16 $(on_bins "$C")" amsedit 16)")
  echo "${ids[*]}"
}

# the control's cold watch timings, recorded in scripts/accl/gate-control/CTL
control() {
  local ctl j d
  ctl=${1:?control commit}
  c=$(git rev-parse HEAD)
  script=$(cat "$here/gate-shard.sh")
  order=""
  j=$(sub "-c 18 --mem=48G -t 00:40:00 -J gf-control" control "$ctl")
  echo "gate-fast: control $ctl, job $j" >&2
  wait_all "$j" > /dev/null
  d=$here/gate-control/$ctl
  mkdir -p "$d"
  cp "$runs/cmd-$j"/cold-control-j*.json "$d/" || { echo "gate-fast: job $j recorded nothing" >&2; exit 1; }
  echo "accl job $j, $(date -u +%Y-%m-%d), on $(sed -n 's/^node \([^,]*\),.*/\1/p' "$runs/cmd-$j/job.log" 2>/dev/null | head -1)" > "$d/recorded.txt"
  ls "$d"
}

# S J: the job's sacct field
acct() { ssh $H "$slurm sacct -j $1 -n -X -P -o $2" 2>/dev/null | head -1; }
secs() { awk -F'[-:]' '{ if (NF == 4) print $1*86400+$2*3600+$3*60+$4; else if (NF == 3) print $1*3600+$2*60+$3; else print $1*60+$2 }' <<< "$1"; }

wait_all() {
  local j s d
  for j in "$@"; do
    while :; do
      s=$(acct "$j" State | awk '{print $1}')
      case $s in COMPLETED | FAILED | CANCELLED* | TIMEOUT | OUT_OF_ME* | NODE_FAIL) break ;; esac
      sleep 20
    done
    mkdir -p "$runs"
    rsync -a "$H:code/flinner/phitex-runs/cmd-$j" "$runs/" 2>/dev/null || true
    rsync -a "$H:code/flinner/phitex-runs/phitex-$j.out" "$runs/" 2>/dev/null || true
  done
  table "$@"
}

table() {
  set +e
  # (the edit histories ran in their own shards: the ams shard's §0 table
  # made again with them)
  local x amsd=""
  for x in "$@"; do grep -q '^ams ' "$runs/cmd-$x/shard.txt" 2>/dev/null && amsd=$runs/cmd-$x; done
  if [ -n "$amsd" ]; then
    for x in "$@"; do grep -q '^amsedit ' "$runs/cmd-$x/shard.txt" 2>/dev/null && cp "$runs/cmd-$x"/edits-j*.json "$amsd/" 2>/dev/null; done
    python3 -I "$here/gate-acct.py" table ams "$amsd" > "$amsd/table.txt" 2>&1
  fi
  local j d st sh status build wall el sub0 end first="" last="" reds=0
  printf '%-8s %-10s %-10s %-6s %7s %7s  %s\n' job shard state gate build_s wall_s red
  for j in "$@"; do
    d=$runs/cmd-$j
    st=$(acct "$j" State | awk '{print $1}')
    el=$(secs "$(acct "$j" Elapsed)")
    sub0=$(acct "$j" Submit)
    end=$(acct "$j" End)
    [ -z "$first" ] || [[ "$sub0" < "$first" ]] && first=$sub0
    [ -z "$last" ] || [[ "$end" > "$last" ]] && last=$end
    sh=$(cat "$d/shard.txt" 2>/dev/null || echo '?')
    status=$(cat "$d/status" 2>/dev/null || echo "none")
    build=$(sed -n 's/^build_s //p' "$d/times.txt" 2>/dev/null)
    wall=$(sed -n 's/^wall_s //p' "$d/times.txt" 2>/dev/null)
    printf '%-8s %-10s %-10s %-6s %7s %7s  %s\n' "$j" "$sh" "$st" "$status" "${build:--}" "${wall:-$el}" "$(cat "$d/red.txt" 2>/dev/null | grep -c .)"
    [ "$status" = green ] || reds=1
  done
  echo
  echo "red (failures first):"
  for j in "$@"; do
    d=$runs/cmd-$j
    if [ -s "$d/red.txt" ]; then sed "s/^/  [$(cut -d' ' -f1 "$d/shard.txt")] /" "$d/red.txt"; fi
    [ -f "$d/status" ] || echo "  [$j] no result: $(tail -3 "$runs/phitex-$j.out" 2>/dev/null | tr '\n' ' ')"
  done
  for j in "$@"; do
    d=$runs/cmd-$j
    if [ -s "$d/known-red.txt" ]; then sed "s/^/  [known red, corpus fixture] /" "$d/known-red.txt"; fi
  done
  echo
  for j in "$@"; do
    d=$runs/cmd-$j
    if [ -f "$d/ams.txt" ]; then echo "amsldoc:"; sed 's/^/  /' "$d/ams.txt"; fi
    if [ -f "$d/para.txt" ]; then echo "para4000:"; sed 's/^/  /' "$d/para.txt"; fi
    if [ -f "$d/table.txt" ]; then cat "$d/table.txt"; fi
    if [ -f "$d/acct.txt" ]; then cat "$d/acct.txt"; fi
    if [ -f "$d/cg.txt" ]; then echo "callgrind:"; sed 's/^/  /' "$d/cg.txt"; fi
    if [ -f "$d/cold.txt" ]; then echo "amsldoc cold watch build by op class, head vs control (same node, same command):"; cat "$d/cold.txt"; fi
  done
  echo
  echo "slowest tests (s):"
  for j in "$@"; do cat "$runs/cmd-$j/test-walls.txt" 2>/dev/null; done | sort -k2 -rn | head -8 | sed 's/^/  /'
  for j in "$@"; do [ -f "$runs/cmd-$j/suite-walls.txt" ] && { echo "suite walls (s):"; sort -k2 -rn "$runs/cmd-$j/suite-walls.txt" | tr '\n' ' ' | sed 's/^/  /'; echo; }; done
  echo
  local a b
  a=$(date -d "$first" +%s 2>/dev/null || echo 0)
  b=$(date -d "$last" +%s 2>/dev/null || echo 0)
  echo "gate wall: $((b - a)) s, first submit $first to last end $last; verdict: $([ $reds = 0 ] && echo GREEN || echo RED)"
}

case ${1:-} in
  wait) shift; wait_all "$@" ;;
  edits) shift; edits50 "$@" ;;
  control) shift; control "$@" ;;
  table) shift; table "$@" ;;
  -h | --help) sed -n '2,20p' "$0" ;;
  *) submit "${1:-HEAD}" ;;
esac
