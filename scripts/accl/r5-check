#!/bin/bash
# r5-edits' check of a commit (on accl, in a job): clippy on the crates
# touched, the tests named, then the edit-time table
# (scripts/accl/edit-classes, amsldoc -j 1 md5 in it).
#   scripts/accl/accl submit cmd bash scripts/accl/r5-check '<cargo test args>' ...
# each argument one `cargo test -p phitex-tex -p phitex-source` call's
# arguments, e.g. '--lib incr::' or '--test edits a_link_removed'.
set -u
cd "$(dirname "$0")/../.."
export CARGO_BUILD_JOBS=16
{
  cargo clippy -q -p phitex-source -p phitex-tex --no-deps --all-targets -- -D warnings > "$r/clippy.txt" 2>&1
  echo "clippy exit $?"
  grep -E -- "^(error|warning)|-->" "$r/clippy.txt" | head -40
  for a in "$@"; do
    # shellcheck disable=SC2086
    CARGO_TARGET_DIR=$w/t-test cargo test -q --release -p phitex-tex $a > "$r/test.txt" 2>&1
    s=$?
    grep -E "^test result|panicked|FAIL|^failures|^    [a-z_:]+$" "$r/test.txt" | head -30
    echo "test '$a' exit $s"
  done
} > "$r/checks.txt" 2>&1
bash scripts/accl/edit-classes
cat "$r/checks.txt" >> "$r/summary.txt"
cat "$r/checks.txt"
