#!/bin/bash
# ssh for the accl drivers (accl and gate-fast call it as $SSH; rsync,
# scp and git reach it through RSYNC_RSH, scp -S and GIT_SSH_COMMAND):
# acclhead1 refuses or resets new connections for minutes when it gets
# many, so a call that fails to connect (exit 255) is tried again after
# 15, 30, 60 and 120 s.
# ACCL_SSH_MUX=1 shares one persistent connection between all calls
# (ControlMaster, socket under ~/.cache/phitex-accl); off by default:
# the sandbox's ssh broker refuses the Control* options.
opts=()
if [ "${ACCL_SSH_MUX:-0}" = 1 ]; then
  mkdir -p "$HOME/.cache/phitex-accl"
  opts=(-o ControlMaster=auto -o "ControlPath=$HOME/.cache/phitex-accl/cm-%r@%h:%p" -o ControlPersist=10m)
fi
for d in 15 30 60 120 -; do
  /usr/bin/ssh "${opts[@]}" "$@"
  e=$?
  [ $e = 255 ] && [ $d != - ] || exit $e
  sleep $d
done
