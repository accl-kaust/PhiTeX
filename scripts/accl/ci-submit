#!/bin/bash
# Submit the CI's stages for one commit (docs/ci.md), on acclhead1 (the
# local `accl ci` and the cron poll call it; the harness is the one last
# synced to $CI/harness):
#
#   ci-submit [--main] COMMIT       prints: RUN SCORE-JOB
#
# The head node only submits: every stage runs on the compute nodes.
set -euo pipefail
export PATH=/opt/slurm/current/bin:$PATH
CI=$HOME/code/flinner/partex-phitex-ci
main=
[ "${1:-}" = --main ] && { main=--main; shift; }
c=$(git -C "$HOME/code/flinner/partex-phitex.git" rev-parse "${1:?commit}^{commit}")
perf=${CI_PERF_NODE:-acclnode04}
run=${c:0:12}-$(date +%Y%m%d-%H%M%S)
S=$CI/harness/ci.sbatch
cd "$CI"
sb() { sbatch --parsable --export=ALL "$@"; }
b=$(sb -J ci-build -p build --qos=build4 -c 32 --mem=64G -t 02:00:00 "$S" build "$run" "$c")
m=$(sb -J ci-manuals -d "afterok:$b" --array="0-${CI_SHARDS:-47}%24" -x "$perf" \
  -p build --qos=build4 -c 4 --mem=48G -t 08:00:00 "$S" manuals "$run")
t=$(sb -J ci-torture -d "afterok:$b" -x "$perf" -p build --qos=build4 -c 48 --mem=160G -t 08:00:00 \
  "$S" torture "$run")
p=$(sb -J ci-perf -d "afterok:$b" -w "$perf" -p build --qos=build4 -c 16 --mem=96G -t 12:00:00 \
  "$S" perf "$run")
s=$(sb -J ci-score -d "afterany:$m:$t:$p" -p light -c 2 --mem=8G -t 01:00:00 "$S" score "$run" $main)
echo "$c $run build=$b manuals=$m torture=$t perf=$p score=$s" >> "$CI/submitted.log"
echo "$run $s"
