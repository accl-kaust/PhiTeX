#!/bin/bash
# Offload partex-PhiTeX work to the accl cluster (run locally, in the
# repository or a worktree of it: scripts/accl/accl ...):
#
#   accl submit <task> [args...]   snapshot the tree, push it, submit; prints the job id
#   accl run <task> [args...]      submit, wait, fetch, print the summary
#   accl wait <job>...             wait for jobs, fetch their results, print summaries
#   accl q                         your jobs
#   accl log <job>                 a job's output so far
#   accl cancel <job>...           cancel your jobs
#   accl snap                      only snapshot and push; prints the commit
#   accl ci [--main] [REV]         the CI for a commit (docs/ci.md): build, the
#                                  manuals, the engine suites, perf, the
#                                  scoreboard; prints the run's name
#   accl ci-wait RUN               wait for a CI run, fetch and print its scoreboard
#   accl ci-oracle LIST            TeX Live's builds of a manual list, cached
#   accl ci-discover               the manual candidates of the CI image
#   accl ci-backfill N REV...      perf history for older commits (one array)
#
# Tasks (job.sbatch): gate | course plain|ab|ssa|rebuild|label ... |
# edits [DOC...] | watch [COURSE] [runs] | cmd <command...>. Each gets resources from its preset
# below; ACCL_OPTS adds or overrides sbatch options (for example
# ACCL_OPTS="-c 16 -t 1:00:00"); ACCL_COMMIT=<rev> submits that commit
# instead of a snapshot of the tree.
#
# The snapshot is the working tree as it is (tracked and untracked files,
# .gitignore respected, the handoff notes and presentation/ left out)
# made into a commit object with a scratch index: the branch, the index
# and the stash are untouched. It is pushed to the `accl` remote as
# refs/wip/<commit>. Results land in ~/code/flinner/partex-phitex-runs/<task>-<job>/
# here and on accl.
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
H=acclhead1
slurm='export PATH=/opt/slurm/current/bin:$PATH;'
runs=$HOME/code/flinner/partex-phitex-runs

preset() {
  case $1 in
    gate) echo "-p build --qos=build4 -c 48 --mem=128G -t 03:00:00" ;;
    course)
      case ${2:-} in
        ssa|rebuild|label) echo "-p build --qos=build4 -c 8 --mem=96G -t 04:00:00" ;;
        *) echo "-p build --qos=build4 -c 8 --mem=48G -t 03:00:00" ;;
      esac ;;
    edits) echo "-p build --qos=build4 -c 8 --mem=32G -t 01:30:00" ;;
    watch) echo "-p build --qos=build4 -c 8 --mem=96G -t 03:00:00" ;;
    *) echo "-p build --qos=build4 -c 16 --mem=64G -t 02:00:00" ;;
  esac
}

snap() {
  local repo idx tree head c
  if [ -n "${ACCL_COMMIT:-}" ]; then
    c=$(git rev-parse "$ACCL_COMMIT^{commit}")
    git push -q accl "$c:refs/wip/$c" 2>/dev/null || true
    echo "$c"
    return
  fi
  repo=$(git rev-parse --show-toplevel)
  idx=$(mktemp)
  cp "$(git rev-parse --git-path index)" "$idx"
  (cd "$repo" && GIT_INDEX_FILE=$idx git add -A -- . ':!HANDOFF.md' ':!GPT_HANDOFF.md' ':!presentation')
  tree=$(GIT_INDEX_FILE=$idx git write-tree)
  rm -f "$idx"
  head=$(git rev-parse HEAD)
  if [ "$tree" = "$(git rev-parse "HEAD^{tree}")" ]; then
    c=$head
  else
    c=$(git commit-tree "$tree" -p "$head" -m "wip snapshot of $(git rev-parse --short HEAD)")
  fi
  git push -q accl "$c:refs/wip/$c" 2>/dev/null || git push -q accl "+$c:refs/wip/$c"
  echo "$c"
}

sync_scripts() {
  rsync -a --delete --exclude=accl "$here/" "$H:code/flinner/partex-phitex-accl/"
  ssh $H "mkdir -p code/flinner/partex-phitex-runs"
}

submit() {
  local task=$1 c opts
  c=$(snap)
  sync_scripts
  opts="$(preset "$@") ${ACCL_OPTS:-}"
  echo "accl: commit $c, $opts" >&2
  ssh $H "$slurm cd code/flinner/partex-phitex-runs && sbatch --parsable -J partex-$task $opts \$HOME/code/flinner/partex-phitex-accl/job.sbatch $c $(printf '%q ' "$@")"
}

state() { ssh $H "$slurm sacct -j $1 -n -X -o State" | awk '{print $1}' | head -1; }

wait_jobs() {
  local j s
  for j in "$@"; do
    while :; do
      s=$(state "$j")
      case $s in COMPLETED | FAILED | CANCELLED* | TIMEOUT | OUT_OF_ME* | NODE_FAIL) break ;; esac
      sleep 20
    done
    mkdir -p "$runs"
    rsync -a "$H:code/flinner/partex-phitex-runs/*-$j" "$runs/" 2>/dev/null || true
    rsync -a "$H:code/flinner/partex-phitex-runs/partex-$j.out" "$runs/" 2>/dev/null || true
    local d
    d=$(ls -d "$runs"/*-"$j" 2>/dev/null | head -1)
    echo "== job $j: $s  ($d)"
    if [ -n "$d" ] && [ -f "$d/summary.txt" ]; then cat "$d/summary.txt"; else tail -30 "$runs/partex-$j.out" 2>/dev/null; fi
  done
}

CI=code/flinner/partex-phitex-ci
# the harness, its data and the stage script, as this tree has them
ci_sync() {
  local repo
  repo=$(git rev-parse --show-toplevel)
  ssh $H "mkdir -p $CI/harness/ci $CI/harness/xetex $CI/harness/data $CI/runs"
  rsync -a --delete --exclude=__pycache__ "$repo/scripts/ci/" "$H:$CI/harness/ci/"
  rsync -a "$repo/scripts/xetex/fonts.conf" "$H:$CI/harness/xetex/"
  rsync -a --delete "$repo/ci/" "$H:$CI/harness/data/"
  rsync -a "$here/ci.sbatch" "$here/backfill.sbatch" "$here/ci-submit" "$here/ci-poll" "$H:$CI/harness/"
}
# sb OPTS... STAGE RUN ARGS...: sbatch a stage, its job id
sb() { ssh $H "$slurm cd $CI && sbatch --parsable --nice=1000 $*"; }
PERF_NODE=${CI_PERF_NODE:-acclnode04}
ci_submit() {
  local main= c
  [ "${1:-}" = --main ] && { main=--main; shift; }
  [ -n "${1:-}" ] && export ACCL_COMMIT=$1
  c=$(snap)
  ci_sync
  echo "accl ci: commit $c" >&2
  ssh $H "CI_SHARDS=${CI_SHARDS:-47} CI_PERF_NODE=$PERF_NODE ${CI_MODES:+CI_MODES=$CI_MODES} \$HOME/$CI/harness/ci-submit $main $c"
}
ci_wait() {
  local run=$1 j=${2:-}
  [ -n "$j" ] && wait_jobs "$j" >/dev/null
  mkdir -p "$runs/ci-$run"
  rsync -a --exclude='bin/' --exclude='*.tar' "$H:$CI/runs/$run/" "$runs/ci-$run/" 2>/dev/null || true
  rsync -a "$H:$CI/report.html" "$H:$CI/history.jsonl" "$runs/" 2>/dev/null || true
  cat "$runs/ci-$run/summary.txt" 2>/dev/null || echo "no summary yet: $runs/ci-$run"
  echo "scoreboard: $runs/ci-$run/scoreboard.md; report: $runs/report.html"
}

cmd=${1:-}
shift || true
case $cmd in
  snap) snap ;;
  submit) submit "$@" ;;
  run) j=$(submit "$@"); echo "accl: job $j" >&2; wait_jobs "$j" ;;
  wait) wait_jobs "$@" ;;
  q) ssh $H "$slurm squeue -u \$USER -o '%.8i %.12j %.9T %.10M %.4C %.6m %R'" ;;
  log) ssh $H "cat code/flinner/partex-phitex-runs/partex-$1.out" ;;
  cancel) ssh $H "$slurm scancel $*" ;;
  ci) ci_submit "$@" ;;
  ci-wait) ci_wait "$@" ;;
  ci-oracle)
    ci_sync
    # (the list beside the harness, not in it: a sync would remove it)
    l=lists/$(date +%Y%m%d-%H%M%S)-$(basename "$1")
    ssh $H "mkdir -p $CI/lists"
    scp -q "$1" "$H:$CI/$l"
    sb -J ci-oracle --array=0-${CI_SHARDS:-63}%24 -x "$PERF_NODE" -p build --qos=build4 -c 2 --mem=6G -t 12:00:00 \
      "\$HOME/$CI/harness/ci.sbatch" oracle "oracle-$(date +%Y%m%d-%H%M%S)" "\$HOME/$CI/$l" ;;
  ci-discover)
    ci_sync
    sb -J ci-discover -p light -c 2 --mem=8G -t 01:00:00 "\$HOME/$CI/harness/ci.sbatch" discover discover ;;
  ci-backfill)
    ci_sync
    n=$1; shift
    list=$(mktemp)
    for r in "$@"; do git rev-parse "$r^{commit}"; done > "$list"
    while read -r c; do git push -q accl "$c:refs/wip/$c" 2>/dev/null || true; done < "$list"
    ssh $H "mkdir -p $CI/lists"
    scp -q "$list" "$H:$CI/lists/backfill.txt"; rm -f "$list"
    sb -J ci-backfill --array=0-$(( $# - 1 ))%${n} -w "$PERF_NODE" -p build --qos=build4 -c 16 --mem=48G -t 12:00:00 \
      "\$HOME/$CI/harness/backfill.sbatch" ;;
  *) sed -n '2,30p' "$0"; exit 2 ;;
esac
