#!/bin/bash
# Offload PhiTeX work to the accl cluster (run locally, in the
# repository or a worktree of it: scripts/accl/accl ...):
#
#   accl submit <task> [args...]   snapshot the tree, push it, submit; prints the job id
#   accl run <task> [args...]      submit, wait, fetch, print the summary
#   accl wait <job>...             wait for jobs, fetch their results, print summaries
#   accl q                         your jobs
#   accl log <job>                 a job's output so far
#   accl cancel <job>...           cancel your jobs
#   accl snap                      only snapshot and push; prints the commit
#   accl ws-clean NAME             remove the kept workspace NAME (ACCL_WS) from its node
#   accl ci-oracle LIST            TeX Live's builds of a manual list, cached
#   accl ci-discover               the manual candidates of the CI image
#
# Tasks (job.sbatch): gate | cmd <command...>. Each gets resources from its preset
# below; ACCL_OPTS adds or overrides sbatch options (for example
# ACCL_OPTS="-c 16 -t 1:00:00"); ACCL_COMMIT=<rev> submits that commit
# instead of a snapshot of the tree.
#
# The snapshot is the working tree as it is (tracked and untracked files,
# .gitignore respected, the handoff notes and presentation/ left out)
# made into a commit object with a scratch index: the branch, the index
# and the stash are untouched. It is pushed to the `accl` remote as
# refs/wip/<commit>. Results land in ~/code/flinner/phitex-runs/<task>-<job>/
# here and on accl.
#
# CLUSTER=mc runs all of it on the mc cluster instead (`ssh mcmgt01`,
# partition mc, its CPU-only nodes; the git remote `mc`; results here
# under ~/code/flinner/phitex-runs/mc/): cluster.sh. Unset, accl.
#
# From another repository with PhiTeX as its phitex/ submodule
# (phitex-frontends), run this script by its path there: the snapshot is
# that repository's working tree, its checked-out submodules each
# snapshotted too, pushed to the cluster's PhiTeX bare repo by URL (no
# remote needed). The job checks the submodules out, fetches crates for
# every Cargo.lock one level down, phitex/'s upstream copy and
# node_modules (npm ci, by package-lock.json). Node 26, npm and the
# wasm32-wasip1 and -threads std are in the image phitex-2026-09-25-node26
# (on mc; accl has only phitex-2026-09-25-tools so far):
#   cd ~/code/flinner/phitex-frontends
#   CLUSTER=mc ACCL_OPTS="-c 16 --mem=32G -t 01:00:00 --export=ALL,ACCL_IMAGE=phitex-2026-09-25-node26" \
#     ~/code/flinner/PhiTeX/scripts/accl/accl run cmd bash -c '<command in the repo root>'
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
# (H, remote, part, light, ws_node, runs: cluster.sh)
. "$here/cluster.sh"
slurm='export PATH=/opt/slurm/current/bin:$PATH;'
# (acclhead1 resets connections under load: every ssh, scp, rsync and
# git call retried, sshmux/ssh)
SSH=$here/sshmux/ssh
export RSYNC_RSH=$SSH GIT_SSH_COMMAND=$SSH

preset() {
  case $1 in
    gate) echo "$part -c 48 --mem=128G -t 03:00:00" ;;
    *) echo "$part -c 16 --mem=64G -t 02:00:00" ;;
  esac
}

# (where snapshots go: the cluster's remote in this repository, else its
# URL, as in a repository without that remote, phitex-frontends, and in
# its submodules)
dest() { git remote get-url $remote > /dev/null 2>&1 && echo $remote || echo "$H:code/flinner/phitex.git"; }

# the gitlinks (submodules) of commit or index: "commit<TAB>path" lines
# (of `git ls-files -s` or `git ls-tree -r`: the field of 40 hex digits)
gitlinks() { awk -F'\t' '$1 ~ /^160000 / {n = split($1, a, " "); for (i = 2; i <= n; i++) if (length(a[i]) == 40 && a[i] !~ /[^0-9a-f]/) print a[i] "\t" $2}'; }

snap() {
  local c sc p d
  d=$(dest)
  if [ -n "${ACCL_COMMIT:-}" ]; then
    c=$(git rev-parse "$ACCL_COMMIT^{commit}")
    git push -q $d "$c:refs/wip/$c" 2>/dev/null || true
    # (its submodules' commits too, from their checkouts)
    while IFS=$'\t' read -r sc p; do
      git -C "$p" push -q "$H:code/flinner/phitex.git" "$sc:refs/wip/$sc" 2>/dev/null || true
    done < <(git ls-tree -r "$c" | gitlinks)
    echo "$c"
    return
  fi
  snap_tree "$d"
}

# snap_tree DEST: the working tree of the repository here as a commit,
# pushed to DEST; a checked-out submodule's working tree snapshotted the
# same way, its gitlink pointing at that commit
snap_tree() {
  local repo idx tree head c sc p
  repo=$(git rev-parse --show-toplevel)
  idx=$(mktemp)
  cp "$(git rev-parse --git-path index)" "$idx"
  (cd "$repo" && GIT_INDEX_FILE=$idx git add -A -- . ':!HANDOFF.md' ':!GPT_HANDOFF.md' ':!presentation')
  while IFS=$'\t' read -r sc p; do
    [ -e "$repo/$p/.git" ] || continue
    sc=$(cd "$repo/$p" && snap_tree "$H:code/flinner/phitex.git") || { rm -f "$idx"; return 1; }
    GIT_INDEX_FILE=$idx git update-index --cacheinfo "160000,$sc,$p"
  done < <(GIT_INDEX_FILE=$idx git ls-files -s | gitlinks)
  tree=$(GIT_INDEX_FILE=$idx git write-tree)
  rm -f "$idx"
  head=$(git rev-parse HEAD)
  if [ "$tree" = "$(git rev-parse "HEAD^{tree}")" ]; then
    c=$head
  else
    c=$(git commit-tree "$tree" -p "$head" -m "wip snapshot of $(git rev-parse --short HEAD)")
  fi
  git push -q $1 "$c:refs/wip/$c" 2>/dev/null || git push -q $1 "+$c:refs/wip/$c"
  echo "$c"
}

sync_scripts() {
  rsync -a --delete --exclude=accl "$here/" "$H:code/flinner/phitex-accl/"
  $SSH $H "mkdir -p code/flinner/phitex-runs"
}

submit() {
  local task=$1 c opts
  c=$(snap)
  sync_scripts
  opts="$(preset "$@") ${ACCL_OPTS:-}"
  # (a kept workspace, job.sbatch's ACCL_WS: on its node, every job)
  if [ -n "${ACCL_WS:-}" ]; then
    opts="$opts -w ${ACCL_WS_NODE:-$ws_node} --export=ALL,ACCL_WS=$ACCL_WS"
  fi
  echo "accl: commit $c, $opts" >&2
  $SSH $H "$slurm cd code/flinner/phitex-runs && sbatch --parsable -J phitex-$task $opts \$HOME/code/flinner/phitex-accl/job.sbatch $c $(printf '%q ' "$@")"
}

# J...: "JobID|State" of all those jobs, one sacct call
states() { $SSH $H "$slurm sacct -j $(IFS=,; echo "$*") -n -X -P -o JobID,State"; }

# (the jobs not yet reported in one query a minute, each reported in
# order once it and those before it ended; a query that fails, acclhead1
# refusing connections, is a poll that saw nothing end)
wait_jobs() {
  local j s i=0 jobs=("$@")
  local -A ended=()
  while [ $i -lt $# ]; do
    while IFS='|' read -r j s _; do
      # (State as sacct's 10-column field prints it: CANCELLED+)
      [ ${#s} -le 10 ] || s=${s:0:9}+
      s=${s%% *}
      case $s in COMPLETED | FAILED | CANCELLED* | TIMEOUT | OUT_OF_ME* | NODE_FAIL) ended[$j]=$s ;; esac
    done < <(states "${jobs[@]:i}" || true)
    while [ $i -lt $# ] && [ -n "${ended[${jobs[i]}]:-}" ]; do
      j=${jobs[i]} s=${ended[${jobs[i]}]}
      i=$((i + 1))
      report "$j" "$s"
    done
    [ $i -ge $# ] || sleep 60
  done
}

report() {
  local j=$1 s=$2
  mkdir -p "$runs"
  rsync -a "$H:code/flinner/phitex-runs/*-$j" "$runs/" 2>/dev/null || true
  rsync -a "$H:code/flinner/phitex-runs/phitex-$j.out" "$runs/" 2>/dev/null || true
  local d
  d=$(ls -d "$runs"/*-"$j" 2>/dev/null | head -1)
  echo "== job $j: $s  ($d)"
  if [ -n "$d" ] && [ -f "$d/summary.txt" ]; then cat "$d/summary.txt"; else tail -30 "$runs/phitex-$j.out" 2>/dev/null; fi
}

CI=code/flinner/phitex-ci
# the harness, its data and the stage script, as this tree has them
ci_sync() {
  local repo
  repo=$(git rev-parse --show-toplevel)
  $SSH $H "mkdir -p $CI/harness/ci $CI/harness/xetex $CI/harness/data $CI/runs"
  rsync -a --delete --exclude=__pycache__ "$repo/scripts/ci/" "$H:$CI/harness/ci/"
  rsync -a "$repo/scripts/xetex/fonts.conf" "$H:$CI/harness/xetex/"
  rsync -a --delete "$repo/ci/" "$H:$CI/harness/data/"
  rsync -a "$here/ci.sbatch" "$H:$CI/harness/"
}
# sb OPTS... STAGE RUN ARGS...: sbatch a stage, its job id
sb() { $SSH $H "$slurm cd $CI && sbatch --parsable --nice=1000 $*"; }
PERF_NODE=${CI_PERF_NODE:-$perf_node}

cmd=${1:-}
shift || true
case $cmd in
  snap) snap ;;
  submit) submit "$@" ;;
  run) j=$(submit "$@"); echo "accl: job $j" >&2; wait_jobs "$j" ;;
  wait) wait_jobs "$@" ;;
  q) $SSH $H "$slurm squeue -u \$USER -o '%.8i %.12j %.9T %.10M %.4C %.6m %R'" ;;
  log) $SSH $H "cat code/flinner/phitex-runs/phitex-$1.out" ;;
  cancel) $SSH $H "$slurm scancel $*" ;;
  ws-clean)
    # (a job on the workspace's node, after any job holding its lock)
    n=${1:?accl ws-clean NAME}
    $SSH $H "$slurm cd code/flinner/phitex-runs && sbatch --parsable -J ws-clean $part -c 1 --mem=1G -t 00:30:00 -w ${ACCL_WS_NODE:-$ws_node} --wrap 'flock /tmp/\$USER-ws-$n.lock rm -rf /tmp/\$USER-ws-$n; rm -f /tmp/\$USER-ws-$n.lock'" ;;
  ci-oracle)
    ci_sync
    # (the list beside the harness, not in it: a sync would remove it)
    l=lists/$(date +%Y%m%d-%H%M%S)-$(basename "$1")
    $SSH $H "mkdir -p $CI/lists"
    scp -q -S "$SSH" "$1" "$H:$CI/$l"
    sb -J ci-oracle --array=0-${CI_SHARDS:-63}%24 ${PERF_NODE:+-x "$PERF_NODE"} $part -c 2 --mem=6G -t 12:00:00 \
      "\$HOME/$CI/harness/ci.sbatch" oracle "oracle-$(date +%Y%m%d-%H%M%S)" "\$HOME/$CI/$l" ;;
  ci-discover)
    ci_sync
    sb -J ci-discover $light -c 2 --mem=8G -t 01:00:00 "\$HOME/$CI/harness/ci.sbatch" discover discover ;;
  *) sed -n '2,43p' "$0"; exit 2 ;;
esac
