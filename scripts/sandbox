#!/usr/bin/env bash
# Run a command inside a bubblewrap sandbox rooted at the repository.
#
#   scripts/sandbox [--net] <command> [args...]
#
# - System dirs (/usr, /etc, TeX Live's /var/lib/texmf formats) read-only;
#   $HOME is an empty tmpfs.
# - Only the repository and cargo's registry/git caches are writable.
# - The rustup toolchain store and the rest of $CARGO_HOME (incl. bin/) are
#   read-only, so build scripts and downloaded code cannot persist outside.
# - No network unless --net is given (cargo is then allowed to fetch).
set -euo pipefail

# Memory is capped here, not by whoever types the command: every run joins
# partex.slice (48G for all of them together) as its own scope, 16G and no
# swap each, at the lowest CPU and IO priority. A runaway test outside the
# slice once took the whole desktop session down with it. PHITEX_NO_SLICE=1
# opts out (CI, machines without a user systemd).
if [ -z "${PHITEX_NO_SLICE:-}" ] && command -v systemd-run >/dev/null \
   && ! grep -q partex.slice /proc/self/cgroup 2>/dev/null \
   && systemctl --user is-active -q -- -.slice 2>/dev/null; then
  exec systemd-run --user --scope -q --slice=partex.slice \
    -p "MemoryMax=${PHITEX_MEMORY_MAX:-16G}" -p MemorySwapMax=0 \
    nice -n 19 ionice -c 3 "$0" "$@"
fi

repo="$(cd "$(dirname "$0")/.." && pwd)"
cargo_home="${CARGO_HOME:-$HOME/.cargo}"
rustup_home="${RUSTUP_HOME:-$HOME/.rustup}"

net=(--unshare-net)
offline=true
if [ "${1:-}" = "--net" ]; then
  net=(--share-net)
  offline=false
  shift
fi
[ $# -gt 0 ] || { echo "usage: $0 [--net] <command> [args...]" >&2; exit 2; }

mkdir -p "$cargo_home/registry" "$cargo_home/git"

args=(
  --unshare-all "${net[@]}"
  --die-with-parent --new-session
  --ro-bind /usr /usr
  --symlink usr/bin /bin --symlink usr/bin /sbin
  --symlink usr/lib /lib --symlink usr/lib /lib64
  --ro-bind /etc /etc
  --ro-bind-try /var/lib/texmf /var/lib/texmf
  --proc /proc --dev /dev
  --tmpfs /tmp
  --tmpfs "$HOME"
  --ro-bind "$rustup_home" "$rustup_home"
  --ro-bind-try "$cargo_home" "$cargo_home"
  --bind "$cargo_home/registry" "$cargo_home/registry"
  --bind "$cargo_home/git" "$cargo_home/git"
  --bind "$repo" "$repo"
  --chdir "$PWD"
  --clearenv
  --setenv HOME "$HOME"
  --setenv PATH "$cargo_home/bin:/usr/bin"
  --setenv CARGO_HOME "$cargo_home"
  --setenv RUSTUP_HOME "$rustup_home"
  --setenv CARGO_NET_OFFLINE "$offline"
  --setenv TERM "${TERM:-dumb}"
  --setenv LANG "${LANG:-C.UTF-8}"
  --setenv TEXMFVAR /tmp/texmf-var
  --setenv PARTEX_SANDBOX 1
)
# phitex's own switches (PARTEX_PERSIST_CHECK, PHITEX_SSA_WORKERS, ...) pass
# through.
while IFS='=' read -r name value; do
  [[ ($name == PARTEX_* || $name == PHITEX_*) && $name != PARTEX_SANDBOX ]] && args+=(--setenv "$name" "$value")
done < <(env)
# One compiler cache for every worktree: sccache's server starts inside each
# sandbox (it runs rustc, so it stays in it), over one cache directory, with
# the worktree's own root stripped from paths so that the same crate hits
# from any checkout. PHITEX_NO_SCCACHE=1 turns it off.
if [ -z "${PHITEX_NO_SCCACHE:-}" ] && command -v sccache >/dev/null; then
  cache="${SCCACHE_DIR:-$HOME/.cache/sccache}"
  mkdir -p "$cache"
  args+=(--bind "$cache" "$cache"
    --setenv RUSTC_WRAPPER sccache
    --setenv SCCACHE_DIR "$cache"
    --setenv SCCACHE_BASEDIRS "$repo"
    --setenv SCCACHE_CACHE_SIZE "${SCCACHE_CACHE_SIZE:-60G}")
fi
# A separate target directory (inside the repo) passes through too.
[ -n "${CARGO_TARGET_DIR:-}" ] && args+=(--setenv CARGO_TARGET_DIR "$CARGO_TARGET_DIR")
# Keep $PWD inside the repo, or a git worktree under ~/code/tmp (bound
# too); fall back to the repo root otherwise.
case "$PWD" in
  "$repo"*) ;;
  "$HOME"/code/tmp/*) args+=(--bind "$PWD" "$PWD" --chdir "$PWD") ;;
  *) args+=(--chdir "$repo") ;;
esac

exec bwrap "${args[@]}" "$@"
