# Cloudflare Pages headers. Any origin may read (the extension's offscreen
# document fetches cross-origin); a versioned file never changes. (One
# splat per rule, at the end: a new TeX Live gets its own block.)
/*
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff

/tl2026/*
  Cache-Control: public, max-age=31536000, immutable

# (the one file that changes: the current release, read again within minutes)
/tl2026/release.json
  ! Cache-Control
  Cache-Control: public, max-age=300

# (a release's own release-<release>.json: its formats added or dropped
# after it is made, the same name; every other file is named by its
# content, a pack table changed a new name: release.py write_table)
/tl2026/release-*
  ! Cache-Control
  Cache-Control: public, max-age=300
