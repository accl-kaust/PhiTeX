{
  // The renderer (viewer/src) and the CLI's host for it, type-checked as
  // both hosts need them: erasable syntax only (the Overleaf extension runs
  // these files in Node with the types stripped), strict, nothing emitted
  // (esbuild bundles). scripts/viewer-typecheck.sh runs it; CI too.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "../crates/partex-cli/viewer/cli.ts"]
}
